#####################################
# POSTGRES (bootstrap user only)
#####################################
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

#####################################
# AIRFLOW
#####################################
AIRFLOW_UID=1000
AIRFLOW_API_AUTH_JWT_SECRET=1e16daafb64b3f324ff52c23238bb73f

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

#####################################
# REDIS
#####################################
REDIS_PASSWORD=redispassword

#####################################
# MONGO
#####################################
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongopassword
MONGO_PORT1=27017
MONGO_PORT2=27018

#####################################
# MONGO EXPRESS
#####################################
ME_CONFIG_MONGODB_ADMINUSERNAME=mongoadmin
ME_CONFIG_MONGODB_ADMINPASSWORD=mongopassword
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin
ME_CONFIG_MONGODB_PORT=27017
ME_PORT=8085

#####################################
# DRUID (application-level credentials)
#####################################
DRUID_USER=druid
DRUID_PASSWORD=druid
DRUID_DB=druid

# Druid JVM
druid_xms=512M
druid_xmx=2G

# Druid metadata (lower-case for injection)
druid_metadata_storage_type=postgresql
druid_metadata_storage_connector_connectURI=jdbc:postgresql://postgres:5432/druid
druid_metadata_storage_connector_user=druid
druid_metadata_storage_connector_password=druid
druid_extensions_loadList='["postgresql-metadata-storage"]'

#####################################
# DRUID PORTS
#####################################
DRUID_COORDINATOR_PORT=8081
DRUID_BROKER_PORT=8082
DRUID_HISTORICAL_PORT=8083
DRUID_MIDDLEMANAGER_PORT=8091
DRUID_ROUTER_PORT=8888

#####################################
# PGADMIN
#####################################
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root
PGADMIN_PORT=5050
